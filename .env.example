# api-wordzen — курсы и аутентификация (Swagger: …/api-wordzen…/swagger-ui)
VITE_API_BASE_URL=https://api-wordzen.stnapps.com

# account-wordzen — аккаунт (коины, подписка в API), друзья, рейтинги
VITE_ACCOUNT_API_BASE_URL=https://account-wordzen.stnapps.com

# payment-wordzen — платёжный шлюз
VITE_PAYMENT_API_BASE_URL=https://payment-wordzen.stnapps.com

# Dev-ключ от бэка (один на api / account / payment). В строке каждый $ экранировать как \$.
VITE_MINIAPP_CLIENT_KEY=\$2y\$10\$dlCPIznVxxkqUh5bWGq4RuglDykU7OkL6Ok.5moZ8YX8bGzMJh1wq

# CDN картинок курсов; в dev см. vite proxy /media
VITE_MEDIA_BASE_URL=https://media.stnapps.com
VITE_MEDIA_PROXY_PREFIX=/media

# В dev (npm run dev) по умолчанию HTTP к API идёт через Vite proxy — CORS на бэке не нужен.
# Прямые запросы на https://… из браузера: VITE_DEV_PROXY=false
VITE_DEV_PROXY=

# --- Docker (docker compose / docker build) ---
# Те же переменные передаются как build-args; см. README «Docker / деплой».